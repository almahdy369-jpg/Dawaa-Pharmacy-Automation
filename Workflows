        "jsCode": "// ===== إعدادات =====\nvar RESERVATION_HOURS = 2;\nvar STATUS_OK = 'reserved';\nvar STATUS_REVIEW = 'pending_pharmacist';\n\nfunction fmt(d) {\n  return d.toLocaleString('sv-SE', { timeZone: 'Africa/Cairo' });\n}\n\nvar rows = [];\nvar items = $input.all();\n\nfor (var i = 0; i < items.length; i++) {\n  var d = items[i].json;\n\n  // الرسالة مش دواء: مفيش حجز\n  if (d.nothing) { continue; }\n\n  var now = new Date();\n  var expires = new Date(now.getTime() + RESERVATION_HOURS * 3600 * 1000);\n  var phone = String(d.customer_id || '');\n  var res_id = 'RES-' + fmt(now).replace(/\\D/g, '') + '-' + phone.slice(-4);\n\n  var base = {\n    res_id: res_id,\n    created_at: fmt(now),\n    customer_id: d.customer_id,\n    wa_phone_id: d.wa_phone_id,\n    customer_name: d.customer_name\n  };\n\n  var before = rows.length;\n  var lines = d.lines || [];\n  var unclear = d.unclear || [];\n\n  // ===== الأدوية اللي اتعرف عليها =====\n  for (var a = 0; a < lines.length; a++) {\n    var l = lines[a];\n    var notes = [];\n\n    if (!l.found) {\n      notes.push('\"' + l.requested_name + '\" مش موجود في الشيت بالاسم ده');\n    }\n    if (l.found && l.fuzzy) {\n      notes.push('مكتوب \"' + l.requested_name + '\" والأقرب ' + l.name + ' (تشابه ' + Math.round(l.similarity * 100) + '%)');\n    }\n    if (l.controlled) {\n      notes.push('دواء controlled');\n    }\n    if (l.found && l.stock <= 0) {\n      notes.push('خلصان من المخزن');\n    } else if (l.found && l.qty > l.stock) {\n      notes.push('المطلوب ' + l.qty + ' والمتاح ' + l.stock);\n    }\n\n    var review = !l.found || l.fuzzy || l.controlled || l.stock <= 0 || l.qty > l.stock;\n\n    if (review && l.alternatives && l.alternatives.length) {\n      var alts = [];\n      for (var k = 0; k < l.alternatives.length; k++) {\n        alts.push(l.alternatives[k].name + ' (' + l.alternatives[k].stock + ')');\n      }\n      notes.push('بدائل: ' + alts.join(', '));\n    }\n\n    var row1 = Object.assign({}, base, {\n      sku: l.sku || '',\n      name: l.found ? l.name : l.requested_name,\n      qty: l.qty,\n      total_egp: l.found ? l.price_egp * l.qty : '',\n      status: review ? STATUS_REVIEW : STATUS_OK,\n      expires_at: fmt(expires),\n      pharmacist: '',\n      note: notes.join(' | ')\n    });\n    rows.push({ json: row1 });\n  }\n\n  // ===== أدوية مش واضحة أو مش في الشيت =====\n  for (var b = 0; b < unclear.length; b++) {\n    var u = unclear[b];\n    var row2 = Object.assign({}, base, {\n      sku: '',\n      name: u.requested_name || '(غير مقروء)',\n      qty: u.qty,\n      total_egp: '',\n      status: STATUS_REVIEW,\n      expires_at: fmt(expires),\n      pharmacist: '',\n      note: u.reason === 'unreadable' ? 'اسم الدواء مش مقروء' : 'مكتوب صح بس مش موجود في الشيت'\n    });\n    rows.push({ json: row2 });\n  }\n\n  // ===== احتياط: مفيش lines ولا unclear =====\n  if (rows.length === before) {\n    var row3 = Object.assign({}, base, {\n      sku: '',\n      name: '',\n      qty: '',\n      total_egp: '',\n      status: STATUS_REVIEW,\n      expires_at: fmt(expires),\n      pharmacist: '',\n      note: 'الرسالة محتاجة مراجعة: ' + (d.text || d.media_id || '')\n    });\n    rows.push({ json: row3 });\n  }\n}\n\nreturn rows;"
