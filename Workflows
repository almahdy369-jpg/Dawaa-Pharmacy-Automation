      "parameters": {
        "jsCode": "// 1) القرار (من نود Parse Decision)\nconst d = $('Parse Decision').first().json;\n\n// 2) كل الكتالوج (من نود Read Catalog (Decision))\nconst catalog = $('Read Catalog (Decision)').all().map(i => i.json);\n\n// 3) سطور الحجز المطابقة لرقم الحجز + لسه pending\n// ⚠️ غيّري 'Read Reservations' لاسم النود الحقيقي اللي بيقرأ شيت الحجوزات\nconst lines = $('Find Pending Lines').all()\n  .map(i => i.json)\n  .filter(r => r.res_id === d.reservation_id && r.status === 'pending_pharmacist');\n\nif (!lines.length) {\n  return [{ json: { ...d, ok: false, toast: 'Rejected', text: 'Already decided or not found' } }];\n}\n\n// 4) الـ stock الحالي لكل SKU\nconst stock = {};\nfor (const c of catalog) stock[c.sku] = Number(c.stock);\n\n// 5) لو approve: نخصم الكمية ونتأكد إن المخزون كفاية\nconst isApprove = d.action === 'approve';\n\nif (isApprove) {\n  for (const l of lines) {\n    stock[l.sku] = (stock[l.sku] ?? 0) - Number(l.qty);\n    if (stock[l.sku] < 0) {\n      return [{ json: {\n        ...d,\n        ok: false,\n        toast: 'Rejected',\n        text: 'Not enough stock for ' + l.name + '. Edit the request or reject.'\n      } }];\n    }\n  }\n}\n\n// 6) وقت الانتهاء (توقيت القاهرة + ساعتين)\nconst exp = $now.setZone('Africa/Cairo').plus({ hours: 2 }).toFormat('yyyy-MM-dd HH:mm');\n\n// 7) الـ stock الجديد للـ SKUs المتأثرة فقط\nconst affected = [...new Set(lines.map(l => l.sku))];\nconst newStock = affected.map(sku => ({ sku, stock: stock[sku] }));\n\n// 8) الإجمالي\nconst total = lines.reduce((s, l) => s + Number(l.total_egp), 0);\n\n// 9) الناتج النهائي\nconst toast = isApprove ? 'Approved' : 'Rejected';\n\nconst text = isApprove\n  ? `✅ تم تأكيد حجزك رقم ${d.reservation_id}\\nالإجمالي: ${total} EGP\\nالحجز ساري لحد ${exp}`\n  : `❌ للأسف تم رفض طلبك رقم ${d.reservation_id}\\nتقدر تتواصل معانا لو محتاج بدائل.`;\n\nreturn [{\n  json: {\n    ...d,\n    ok: true,\n    toast,                 // Approved أو Rejected\n    text,                  // الرسالة اللي هتتبعت\n    status: isApprove ? 'approved' : 'rejected',\n    lines,\n    newStock,              // مثال: [{ sku: \"P008\", stock: 29 }]\n    exp,\n    wa_phone_id: lines[0].wa_phone_id,\n    total\n  }\n}];"
      },
