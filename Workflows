        "jsCode": "// Add the expired quantities back per SKU (several lines can hold the same medicine).\nconst expired = $input.all().map(i => i.json).filter(r => r.sku && !r.debug);\n\nif (!expired.length) return [];\n\n// الكميات الراجعة لكل SKU\nconst back = {};\nfor (const r of expired) {\n  back[r.sku] = (back[r.sku] || 0) + Number(r.qty);\n}\n\n// الـ stock الحالي من الكتالوج\nconst cat = Object.fromEntries(\n  $('Read Catalog').all().map(i => [i.json.sku, i.json])\n);\n\nreturn Object.entries(back)\n  .filter(([sku]) => cat[sku])\n  .map(([sku, q]) => ({\n    json: {\n      sku,\n      returned: q,\n      stock: Number(cat[sku].stock) + q\n    }\n  }));"
