      "parameters": {
        "jsCode": "// Reservations not picked up within 2 hours expire, and their stock goes back on the shelf.\nconst nowCairo = $now.setZone('Africa/Cairo');\nconst nowNum = Number(nowCairo.toFormat('yyyyMMddHHmm'));\n\n// بيفهم الصيغتين:\n//   \"2026-11-20 11:56\" أو \"2026-11-20 9:44\"\n//   \"6:58:00 2026/11/21 م\"  (صيغة الشيت العربية)\nfunction toNum(s) {\n  s = String(s || '').trim()\n    .replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d)); // أرقام عربية -> إنجليزي\n\n  let y, mo, d, h, mi;\n  let m = s.match(/(\\d{4})[-\\/](\\d{1,2})[-\\/](\\d{1,2})\\D+(\\d{1,2}):(\\d{2})/);          // التاريخ ثم الوقت\n  if (m) {\n    [, y, mo, d, h, mi] = m;\n  } else {\n    m = s.match(/(\\d{1,2}):(\\d{2})(?::\\d{2})?\\s+(\\d{4})[-\\/](\\d{1,2})[-\\/](\\d{1,2})/); // الوقت ثم التاريخ\n    if (!m) return null;\n    [, h, mi, y, mo, d] = m;\n  }\n\n  h = Number(h);\n  if (/م|PM/i.test(s) && h < 12) h += 12;    // م = مساءً\n  if (/ص|AM/i.test(s) && h === 12) h = 0;    // ص = صباحاً\n\n  const p = n => String(n).padStart(2, '0');\n  return Number(y + p(mo) + p(d) + p(h) + mi);\n}\n\n// رقم العميل لازم يكون نص (12 رقم يبدأ بـ 20)\nconst isCustomerPhone = v => /^20\\d{10}$/.test(String(v || '').trim());\n\nconst rows = $('Read Reservations').all().map(i => i.json);\n\nconst expired = rows.filter(r => {\n  const status = String(r.status || '').trim().toLowerCase();\n  const exp = toNum(r.expires_at);\n  return r.res_id && status === 'reserved' && exp !== null && exp < nowNum;\n});\n\nif (!expired.length) {\n  // للتشخيص: يوريكي ليه مفيش حاجة طلعت\n  return [{ json: {\n    debug: 'no expired rows',\n    now: nowCairo.toFormat('yyyy-MM-dd HH:mm'),\n    checked: rows.map(r => ({\n      res_id: r.res_id,\n      status: r.status,\n      expires_at: r.expires_at,\n      parsed: toNum(r.expires_at)\n    }))\n  } }];\n}\n\nreturn expired.map(r => {\n  const a = String(r.customer_id || '').trim();\n  const b = String(r.wa_phone_id || '').trim();\n  const customer_phone = isCustomerPhone(a) ? a : (isCustomerPhone(b) ? b : a);\n\n  return { json: { ...r, new_status: 'expired', customer_phone } };\n});"
      },
