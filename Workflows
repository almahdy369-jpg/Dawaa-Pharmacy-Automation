 ? ai.medicines : [];\n\n// ===== المعالجة =====\nconst lines = [];\nconst unclear = [];\nlet hasUnreadable = false;\n\nconst alternativesFor = (row) => sheet\n  .filter(r => r.active_ingredient === row.active_ingredient && r.sku !== row.sku && r.stock > 0)\n  .map(r => ({ sku: r.sku, name: r.name, strength: r.strength, form: r.form, price_egp: r.price_egp, stock: r.stock, controlled: r.controlled }));\n\nfor (const m of medicines) {\n  const requested = String(m.name ?? '').trim();\n  const qty = Number(m.qty) || 1;\n\n  if (!requested) {\n    hasUnreadable = true;\n    unclear.push({ requested_name: '', qty, reason: 'unreadable' });\n    continue;\n  }\n\n  const q = compact(requested);\n  const qFirst = compact(firstToken(requested));\n\n  // 1) بحث بالاسم (fuzzy)\n  let best = null, bestScore = 0;\n  for (const row of sheet) {\n    const n = compact(row.name);\n    const s = Math.max(sim(q, n), sim(qFirst, n));\n    if (s > bestScore) { bestScore = s; best = row; }\n  }\n\n  if (best && bestScore >= MIN_SIMILARITY) {\n    const exact = q === compact(best.name);\n    const fuzzy = !exact;\n    lines.push({\n      requested_name: requested,\n      qty,\n      found: true,\n      matched_by: 'name',\n      ...best,\n      similarity: Math.round(bestScore * 100) / 100,\n      fuzzy,\n      alternatives: (fuzzy || best.stock <= 0) ? alternativesFor(best) : [],\n    });\n    continue;\n  }\n\n  // 2) مفيش اسم مطابق: دوّري بالمادة الفعالة (لو العميل كتبها أو Gemini رجّعها)\n  const ing = compact(m.active_ingredient || requested);\n  const ingMatches = sheet.filter(r =>\n    String(r.active_ingredient).toLowerCase().split(/[\\/,+]/).some(t => sim(compact(t), ing) >= MIN_SIMILARITY)\n  );\n  if (ingMatches.length) {\n    lines.push({\n      requested_name: requested,\n      qty,\n      found: false,\n      matched_by: 'active_ingredient',\n      fuzzy: true,\n      alternatives: ingMatches.filter(r => r.stock > 0).map(r => ({\n        sku: r.sku, name: r.name, strength: r.strength, form: r.form,\n        price_egp: r.price_egp, stock: r.stock, controlled: r.controlled,\n      })),\n    });\n    continue;\n  }\n\n  // 3) مكتوب صح بس مش في الشيت\n  unclear.push({ requested_name: requested, qty, reason: 'not_in_sheet' });\n}\n\n// ===== النتيجة النهائية =====\nconst readable = !parseFailed && ai.readable !== false && !hasUnreadable;\n\n// nothing = true لو مفيش أي دواء اتلقى في الشيت (لا بالاسم ولا بالمادة الفعالة)\n// وده بيشمل: الرسالة مش دواء أصلًا، أو الدواء المكتوب مش موجود في الشيت\nconst nothing = !parseFailed && ai.readable !== false && !hasUnreadable && lines.length === 0;\n\nconst foundLines = lines.filter(l => l.found);\nconst need_pharmacist = !nothing && (\n  !readable ||\n  unclear.length > 0 ||\n  lines.some(l => l.fuzzy || !l.found || l.controlled || l.stock <= 0)\n);\n\n// group = رقم الـ Row (أو الـ Rows) اللي لقى فيها الدواء في الشيت\nconst group = foundLines.map(l => l.row_number);\n\nreturn [{\n  json: {\n    customer_id: c.customer_id,\n    customer_name: c.customer_name,\n    wa_phone_id: c.wa_phone_id,\n    type: c.type,\n    text: c.text,\n    media_id: c.media_id,\n    group,\n    lines,\n    unclear,\n    readable,\n    need_pharmacist,\n    nothing,\n    total: foundLines.reduce((sum, l) => sum + l.stock, 0),\n  },\n}];"
