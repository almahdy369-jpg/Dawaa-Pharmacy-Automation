        "jsCode": "// Turn any failure into one row: which workflow, which node, what kind of error.\nconst e = $json.execution || {};\nconst wf = $json.workflow || {};\nconst msg = String(e.error?.message || $json.trigger?.error?.message || 'Unknown error').slice(0, 500);\n\nconst rules = [\n  [/401|403|unauthori[sz]ed|invalid.*(token|credentials)|expired/i, 'auth', 'critical'],\n  [/429|rate limit|too many requests|quota/i, 'rate_limit', 'warning'],\n  [/ETIMEDOUT|ECONNRESET|ENOTFOUND|timeout|socket hang up|aborted/i, 'network', 'warning'],\n  [/VALIDATION:/, 'validation', 'info'],\n  [/AI_OUTPUT:|JSON|Unexpected token/i, 'ai_output', 'warning'],\n  [/PUT_[A-Z_]+|chat not found|not configured/i, 'config', 'critical']\n];\n\nconst [, type, severity] = rules.find(([re]) => re.test(msg)) || [null, 'unknown', 'warning'];\n\nreturn [{\n  json: {\n    time: $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm'),\n    workflow: wf.name || '',\n    node: e.lastNodeExecuted || '',\n    execution_url: e.url || '',\n    type,\n    severity,\n    message: msg,\n    text: (severity === 'critical' ? '🚨' : '⚠️') + ' ' + (wf.name || 'Workflow') + ' - ' + type +\n          '\\nNode: ' + (e.lastNodeExecuted || '?') +\n          '\\n' + msg +\n          '\\n' + (e.url || '')\n  }\n}];"
